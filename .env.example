# Copy to .env for local development. Never commit .env.
# Staging/production: CF_ACCESS_* are secrets (`npx wrangler secret put <NAME> --env staging`);
# the app addresses are plain vars in wrangler.jsonc.

CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=                      # Access application audience (AUD) tag of the portal's own Access app
# Local dev only (ignored in deployed builds):
DEV_USER_EMAIL=                     # signed-in user when there is no Cloudflare Access header

# Where each tile links. Empty = the tile shows "Address not set yet".
OPERATIONAL_URL=
CMS_URL=
CLIENTZONE_ADMIN_URL=
